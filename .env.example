# Copy to .env.local for local development. Never commit real values.
NODE_ENV=development
PORT=3000

# App access gate
# SHA-256 hex digest of the local password
RAFIQ_APP_PASSWORD_HASH=
# Independent random value with at least 32 characters
RAFIQ_APP_SESSION_SECRET=

# Gemini or Vertex AI
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Web search. Leave provider and key empty to expose an honest unavailable state.
RAFIQ_WEB_SEARCH_PROVIDER=
RAFIQ_WEB_SEARCH_API_KEY=
RAFIQ_WEB_SEARCH_ENGINE_ID=
RAFIQ_WEB_SEARCH_LOCALE=ar-EG
RAFIQ_WEB_SEARCH_REGION=eg

# Optional vector memory. Disabled by default.
RAFIQ_VECTOR_MEMORY_ENABLED=false
REDIS_URL=
REDIS_AGENT_MEMORY_API_KEY=
REDIS_AGENT_MEMORY_SERVER_URL=
REDIS_AGENT_MEMORY_STORE_ID=
REDIS_AGENT_MEMORY_NAMESPACE=rafiq
RAFIQ_REDIS_VECTOR_INDEX=idx:rafiq:mem:v1
RAFIQ_REDIS_VECTOR_PREFIX=rafiq:mem:
RAFIQ_EMBEDDING_MODEL=gemini-embedding-001
RAFIQ_EMBEDDING_DIM=768
RAFIQ_VECTOR_MAX_TEXT_CHARS=1200
RAFIQ_VECTOR_RETRIEVAL_LIMIT=5
RAFIQ_VECTOR_MAX_DISTANCE=0.62

# Optional cache provider
RAFIQ_LANGCACHE_ENABLED=false
RAFIQ_LANGCACHE_TTL_SECONDS=900

# Copy to .env.local for local development. Never commit real values.
NODE_ENV=development
PORT=3000

# App access gate
RAFIQ_APP_PASSWORD_HASH=
RAFIQ_APP_SESSION_SECRET=

# Runtime locale and timezone. These preserve the current reference defaults.
RAFIQ_DEFAULT_LOCALE=ar-EG
RAFIQ_DEFAULT_TIMEZONE=Africa/Cairo

# Gemini API / Vertex AI
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
RAFIQ_MODEL_FAST=
RAFIQ_MODEL_NORMAL=
RAFIQ_MODEL_DEEP=
RAFIQ_HEALTHCHECK_MODEL=

# Optional AgentRouter inference
AGENT_ROUTER_TOKEN=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=gpt-5.6-sol

# Optional web search
RAFIQ_WEB_SEARCH_PROVIDER=
RAFIQ_WEB_SEARCH_API_KEY=
RAFIQ_WEB_SEARCH_ENGINE_ID=
RAFIQ_WEB_SEARCH_LOCALE=ar-EG
RAFIQ_WEB_SEARCH_REGION=eg

# Optional vector memory
RAFIQ_VECTOR_MEMORY_ENABLED=false
REDIS_URL=
AGENT_MEMORY_API_KEY=
REDIS_AGENT_MEMORY_API_KEY=
REDIS_AGENT_MEMORY_SERVER_URL=
REDIS_AGENT_MEMORY_STORE_ID=
REDIS_AGENT_MEMORY_NAMESPACE=rafiq
RAFIQ_REDIS_VECTOR_INDEX=idx:rafiq:mem:v1
RAFIQ_REDIS_VECTOR_PREFIX=rafiq:mem:
RAFIQ_EMBEDDING_MODEL=gemini-embedding-001
RAFIQ_EMBEDDING_DIM=768
RAFIQ_VECTOR_MAX_TEXT_CHARS=1200
RAFIQ_VECTOR_RETRIEVAL_LIMIT=5
RAFIQ_VECTOR_MAX_DISTANCE=0.62

# Optional LangCache semantic response cache
RAFIQ_LANGCACHE_ENABLED=false
LANGCACHE_API_KEY=
REDIS_LANGCACHE_API_KEY=
REDIS_LANGCACHE_SERVER_URL=
REDIS_LANGCACHE_CACHE_ID=
RAFIQ_LANGCACHE_SIMILARITY_THRESHOLD=0.91
RAFIQ_LANGCACHE_TTL_MS=604800000
RAFIQ_LANGCACHE_USE_ATTRIBUTES=false
